def add_option_args(p):
    p.add_argument("--keep", type=int)
    p.add_argument("--pause-service", action="append")
    p.add_argument("--exclude", action="append")
    p.add_argument("--no-pause", dest="pause_service", action="store_const", const=[])
    p.add_argument("--no-exclude", dest="exclude", action="store_const", const=[])


def main():
    if "--version" in sys.argv[1:2]:
        print(f"Pi Backup Manager {VERSION}")
        return
    if os.geteuid() != 0:
        fail("This helper must run as root.")
    ap = argparse.ArgumentParser(prog="pibackup-helper")
    ap.add_argument("--watch-stdin", action="store_true",
                    help="cancel the running job when stdin closes (used by the GUI)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("backup")
    add_option_args(b)
    b.add_argument("--save-options", action="store_true", help="also store these settings for scheduled runs")
    b.add_argument("--scheduled", action="store_true", help="use stored settings (run by the timer)")
    b.add_argument("--source", default="/")
    b.add_argument("--boot", default="/boot/firmware")
    v = sub.add_parser("verify")
    v.add_argument("name")
    r = sub.add_parser("restore-files")
    r.add_argument("name")
    r.add_argument("--dest", required=True)
    r.add_argument("--paths-file", help="file with one path per line")
    r.add_argument("paths", nargs="*")
    ix = sub.add_parser("index", help="make the backup's contents list available to the GUI")
    ix.add_argument("name")
    s = sub.add_parser("restore-system")
    s.add_argument("name")
    s.add_argument("--mode", choices=["standard", "raid"], default="standard")
    s.add_argument("--disk", dest="disks", action="append", required=True)
    s.add_argument("--boot-part")
    s.add_argument("--confirm", required=True)
    dl = sub.add_parser("delete")
    dl.add_argument("name")
    sub.add_parser("mount")
    sl = sub.add_parser("set-location")
    sl.add_argument("--uuid", required=True)
    sl.add_argument("--subdir", default="pi-backups")
    fl = sub.add_parser("format-location")
    fl.add_argument("device")
    fl.add_argument("--label", default="PIBACKUP")
    fl.add_argument("--confirm", required=True)
    so = sub.add_parser("set-options")
    add_option_args(so)
    sc = sub.add_parser("set-schedule")
    add_option_args(sc)
    sc.add_argument("--mode", choices=["off", "daily", "weekly", "monthly"], required=True)
    sc.add_argument("--time", default="02:30")
    sc.add_argument("--days", default="")
    sc.add_argument("--dom", type=int, default=1)
    sc.add_argument("--persistent", action="store_true")
    sc.add_argument("--verify", action="store_true")
    sc.add_argument("--extra", action="append", help="one-time backup, 'YYYY-MM-DD HH:MM' (repeatable)")
    sc.add_argument("--no-extras", dest="extra", action="store_const", const=[])
    sub.add_parser("scan-services")
    a = ap.parse_args()

    signal.signal(signal.SIGTERM, lambda *_: cancel.set())
    if a.watch_stdin:
        watch_stdin()
    try:
        {"backup": cmd_backup, "verify": cmd_verify, "restore-files": cmd_restore_files,
         "restore-system": cmd_restore_system, "delete": cmd_delete, "mount": cmd_mount,
         "set-location": cmd_set_location, "format-location": cmd_format_location,
         "set-options": cmd_set_options, "set-schedule": cmd_set_schedule,
         "scan-services": cmd_scan_services, "index": cmd_index}[a.cmd](a)
    except SystemExit:
        raise
    except Exception as e:
        fail(f"Unexpected error: {e}")


if __name__ == "__main__":
    main()
