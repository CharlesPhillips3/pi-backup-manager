    def load_options_into_ui(self):
        o = dict(DEFAULT_OPTS, **(self.conf.get("options") or {}))
        if not self.conf.get("options"):
            o["excludes"] = [d for d in OLLAMA_DIRS if os.path.isdir(d)]
        self.pause_services = list(o["pause_services"])
        self.update_pause_label()
        self.excl_entry.set_text("; ".join(o["excludes"]))
        self.keep_spin.set_value(o["keep"])

    def update_pause_label(self):
        self.pause_lbl.set_text(", ".join(s.replace(".service", "") for s in self.pause_services)
                                or "nothing (keep everything running)")

    def option_args(self):
        args = ["--keep", str(int(self.keep_spin.get_value()))]
        if self.pause_services:
            for s in self.pause_services:
                args += ["--pause-service", s]
        else:
            args.append("--no-pause")
        ex = [p.strip() for p in self.excl_entry.get_text().split(";") if p.strip()]
        bad = [p for p in ex if not p.startswith("/")]
        if bad:
            self.message(f"Folders to skip must be full paths starting with /: {bad[0]}", error=True)
            return None
        if ex:
            for p in ex:
                args += ["--exclude", p]
        else:
            args.append("--no-exclude")
        return args

    def on_scan_services(self, *_):
        self.scan_results = []
        self.quiet_done = True
        self.after_job = lambda ok: ok and self.on_choose_services(scan=self.scan_results)
        self.run_job(["scan-services"], "Scanning running services…", cancellable=False)

    def on_choose_services(self, scan=None):
        svcs = running_services()
        found = {r["unit"]: r for r in (scan or []) if r.get("scope") == "system"}
        user_found = [r for r in (scan or []) if r.get("scope") == "user"]
        named = [s for s in svcs if DATA_SVC.search(s) and s not in found]
        others = [s for s in svcs if s not in found and s not in named]
        dlg = Gtk.Dialog(title="Pause services during backup", transient_for=self, modal=True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        dlg.set_default_size(620, 560)
        area = dlg.get_content_area()
        area.set_spacing(6)
        area.set_border_width(8)
        intro = Gtk.Label(xalign=0)
        intro.set_line_wrap(True)
        intro.set_markup("Services that keep databases or data files open should be stopped for the few "
                         "minutes the copy takes, so their data is saved in a clean state. They are "
                         "restarted automatically afterwards."
                         + ("" if scan is not None else "\n<small>Tip: <b>Scan…</b> checks what each "
                            "service actually has open and ticks the ones worth pausing.</small>"))
        area.pack_start(intro, False, False, 4)
        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        lb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, border_width=6)
        sw.add(lb)
        area.pack_start(sw, True, True, 0)
        checks = {}

        def header(text):
            h = Gtk.Label(xalign=0)
            h.set_markup(f"<b>{text}</b>")
            lb.pack_start(h, False, False, 6)

        def add(unit, active, reasons=(), recommend=False, sensitive=True, suffix=""):
            cb = Gtk.CheckButton()
            lab = Gtk.Label(xalign=0)
            name = GLib.markup_escape_text(unit.replace(".service", ""))
            tag = "  <span foreground='#26803c'><b>recommended</b></span>" if recommend else ""
            lab.set_markup(f"{name}{suffix}{tag}")
            cb.add(lab)
            cb.set_active(active)
            cb.set_sensitive(sensitive)
            lb.pack_start(cb, False, False, 0)
            for r in reasons:
                rl = Gtk.Label(xalign=0)
                rl.set_line_wrap(True)
                rl.set_margin_start(28)
                rl.set_markup(f"<small>{GLib.markup_escape_text(r)}</small>")
                lb.pack_start(rl, False, False, 0)
            if sensitive:
                checks[unit] = cb

        if scan is not None:
            header(f"Found by scan ({len(found)})" if found else "Found by scan")
            if not found:
                n = Gtk.Label(xalign=0)
                n.set_markup("<small>No system service has database or data files open right now.</small>")
                lb.pack_start(n, False, False, 0)
            for unit in sorted(found, key=lambda u: (not found[u]["recommend"], u)):
                r = found[unit]
                add(unit, unit in self.pause_services or r["recommend"], r["reasons"], r["recommend"])
        if named:
            header("Name suggests it holds data")
            for unit in named:
                add(unit, unit in self.pause_services)
        if others:
            header("Other running services")
            for unit in others:
                add(unit, unit in self.pause_services)
        missing = [u for u in self.pause_services if u not in checks]
        if missing:
            header("Chosen earlier, not running now")
            for unit in missing:
                add(unit, True)
        if user_found:
            header("User services (can't be paused automatically)")
            for r in user_found:
                add(r["unit"], False, r["reasons"] + ["Runs in a user session; it is backed up as it is."],
                    sensitive=False, suffix=f"  (user {r.get('user', '')})")
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            self.pause_services = [u for u, cb in checks.items() if cb.get_active()]
            self.update_pause_label()
            if scan is not None:
                self.bar.set_text("Pause list updated. Back up now or Save schedule stores it.")
        dlg.destroy()

    def on_add_exclude(self, *_):
        d = Gtk.FileChooserDialog(title="Folder to skip", transient_for=self,
                                  action=Gtk.FileChooserAction.SELECT_FOLDER)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Skip this folder", Gtk.ResponseType.OK)
        if d.run() == Gtk.ResponseType.OK:
            p = d.get_filename()
            cur = [x.strip() for x in self.excl_entry.get_text().split(";") if x.strip()]
            if p and p not in cur:
                cur.append(p)
            self.excl_entry.set_text("; ".join(cur))
        d.destroy()

