    def load_schedule_into_ui(self):
        s = self.conf.get("schedule") or {"mode": "off", "time": "02:30", "days": ["Sun"], "dom": 1,
                                          "persistent": True, "verify": False}
        self._loading = True
        self.mode_combo.set_active_id(s.get("mode", "off"))
        hh, mm = s.get("time", "02:30").split(":")
        self.hour_combo.set_active_id(f"{int(hh):02d}")
        self.min_combo.set_active_id(mm if mm in ("00", "15", "30", "45") else "30")
        for d, t in self.day_toggles.items():
            t.set_active(d in (s.get("days") or ["Sun"]))
        self.dom_spin.set_value(int(s.get("dom", 1)))
        self.persist_cb.set_active(bool(s.get("persistent", True)))
        self.verify_cb.set_active(bool(s.get("verify", False)))
        self._loading = False
        self.on_schedule_changed()

    def ui_schedule(self):
        return {"mode": self.mode_combo.get_active_id() or "off",
                "time": f"{self.hour_combo.get_active_id() or '02'}:{self.min_combo.get_active_id() or '30'}",
                "days": [d for d, t in self.day_toggles.items() if t.get_active()],
                "dom": int(self.dom_spin.get_value())}

    def on_schedule_changed(self, *_):
        if getattr(self, "_loading", False):
            return
        s = self.ui_schedule()
        mode = s["mode"]
        self.days_box.set_visible(mode == "weekly")
        self.dom_box.set_visible(mode == "monthly")
        self.time_box.set_visible(mode != "off")
        for w in (self.persist_cb, self.verify_cb):
            w.set_sensitive(mode != "off")
        hh = int(s["time"][:2])
        self.time_hint.set_markup("<small>(night-time is best: the Pi is usually idle)</small>"
                                  if 1 <= hh <= 5 else "")
        runs = next_runs(s)
        if mode == "off":
            self.next_lbl.set_markup("Automatic backups are <b>off</b>.")
        elif not runs:
            self.next_lbl.set_markup("<b>Pick at least one day.</b>")
        else:
            self.next_lbl.set_markup("Next backups: <b>" + "</b>, <b>".join(
                r.strftime("%a %d %b %H:%M") for r in runs) + "</b>")
        saved = self.conf.get("schedule") or {"mode": "off"}
        changed = any(saved.get(k) != s[k] for k in ("mode", "time", "dom")) or \
            (mode == "weekly" and saved.get("days") != s["days"])
        self.sched_save_btn.set_label("Save schedule" + (" *" if changed else ""))
        self.mark_calendar()

    def mark_calendar(self):
        if hasattr(self, "cal") and hasattr(self, "mode_combo"):
            self.cal.redraw()
            self.show_day(self.cal.selected)

    def backups_on(self, day):
        key = day.strftime("%Y-%m-%d")
        return [b for b in self.backups if b["name"].startswith(key)]

    def scheduled_on(self, day):
        s = self.ui_schedule()
        if day < dt.date.today() or not schedule_matches(s, day):
            return False
        hh, mm = (int(x) for x in s["time"].split(":"))
        return dt.datetime.combine(day, dt.time(hh, mm)) > dt.datetime.now()

    def day_marks(self, day):
        if not hasattr(self, "mode_combo"):
            return False, False
        return bool(self.backups_on(day)), self.scheduled_on(day)

    def show_day(self, d):
        lines = [f"<b>{d.strftime('%A %d %B %Y')}</b>"]
        for b in self.backups_on(d):
            chk = b.get("verified", "not checked yet")
            lines.append(f"✓ Backup at {b['name'][11:13]}:{b['name'][13:]} — {gb(backup_size(b))}"
                         f"{' (scheduled)' if b.get('scheduled') else ''}, checked: {chk}")
        if self.scheduled_on(d):
            lines.append(f"• Backup scheduled at {self.ui_schedule()['time']}")
        if len(lines) == 1:
            lines.append("Nothing on this day.")
        self.day_info.set_markup("\n".join(lines))

    def on_save_schedule(self, *_):
        s = self.ui_schedule()
        if s["mode"] == "weekly" and not s["days"]:
            self.message("Pick at least one day of the week.", error=True)
            return
        opts = self.option_args()
        if opts is None:
            return
        args = ["set-schedule", "--mode", s["mode"], "--time", s["time"],
                "--days", ",".join(s["days"]), "--dom", str(s["dom"])] + opts
        if self.persist_cb.get_active():
            args.append("--persistent")
        if self.verify_cb.get_active():
            args.append("--verify")
        self.run_job(args, "Saving schedule…")

