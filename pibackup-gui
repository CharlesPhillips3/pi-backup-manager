    def refresh_location_tab(self):
        self.conf = read_conf()
        loc_uuid = (self.conf.get("location") or {}).get("uuid")
        self.dstore.clear()
        for top in block_devices():
            if top.get("type") != "disk" or top["name"].startswith(("zram", "loop", "ram")):
                continue
            nodes = list(walk(top))
            disk_system = any(m in SYSTEM_MOUNTS for n in nodes for m in mounts_of(n))
            raid_members = {n["path"] for n in nodes if n.get("fstype") == "linux_raid_member"}
            tran = (top.get("tran") or "").lower()
            kind = {"usb": "USB", "nvme": "NVMe", "mmc": "SD card", "sata": "SATA"}.get(tran, tran.upper())
            name = f"{top['path']}  {top.get('model') or kind}".strip()
            roles = []
            if disk_system:
                roles.append("drive your system runs from")
            elif top.get("rm") or tran == "usb":
                roles.append(f"removable {kind}".strip())
            if loc_uuid and any(n.get("uuid") == loc_uuid for n in nodes):
                roles.append("holds your backups")
            can_format = not disk_system and not raid_members
            why = ("This drive holds your running system, so it can't be erased." if disk_system else
                   "This drive is part of a RAID array." if raid_members else "")
            it = self.dstore.append(None, [top["path"], name, gb(int(top["size"])), "", "", "",
                                           0, "", ", ".join(roles), False, can_format, "", "", why, tran])
            children = [c for c in (top.get("children") or []) if c.get("type") == "part"]
            if not children and top.get("fstype"):
                children = []  # filesystem directly on the disk is handled below
                self.add_part_row(it, top, loc_uuid, disk_system, kind, whole=True)
            for p in children:
                self.add_part_row(it, p, loc_uuid, disk_system, kind)
        self.dtree.expand_all()
        loc = self.conf.get("location")
        if loc:
            mounted = location_mounted(self.conf)
            extra = ""
            if mounted:
                u = disk_usage(store_dir(self.conf))
                extra = f" — {gb(u.free)} free"
            folder = f", folder “{loc['subdir']}”" if loc.get("subdir") else ""
            self.loc_lbl.set_markup(f"Backups are stored on <b>{GLib.markup_escape_text(loc['desc'])}</b>"
                                    f"{GLib.markup_escape_text(folder)}{extra}"
                                    + ("" if mounted else "  <b>(not connected)</b>"))
        else:
            self.loc_lbl.set_markup("<b>No backup location yet.</b> Pick a drive or partition below.")
        self.on_disk_selected()

    def add_part_row(self, parent, p, loc_uuid, disk_system, kind, whole=False):
        mps = mounts_of(p)
        fs = p.get("fstype") or ""
        system = any(m in SYSTEM_MOUNTS for m in mps)
        raid = fs == "linux_raid_member"
        roles = []
        if "/" in mps:
            roles.append("your system")
        elif "/boot/firmware" in mps or "/boot" in mps:
            roles.append("boot partition")
        elif "[SWAP]" in mps:
            roles.append("swap")
        if raid:
            md = [c for c in (p.get("children") or []) if (c.get("type") or "").startswith("raid")]
            where = mounts_of(md[0]) if md else []
            roles.append(f"RAID member{(' of ' + md[0]['name']) if md else ''}"
                         f"{(' (' + where[0] + ')') if where else ''}")
        if loc_uuid and p.get("uuid") == loc_uuid:
            roles.append("★ backup location")
        if not fs:
            roles.append("empty / unformatted")
        can_use = fs in USABLE_FS and not system and not raid and p.get("uuid") != loc_uuid
        why = ""
        if system:
            why = "This partition is part of the running system."
        elif raid:
            why = "This partition belongs to a RAID array."
        elif fs and fs not in USABLE_FS:
            why = f"'{fs}' can't hold backups; erase it to use it."
        elif not fs:
            why = "Not formatted; erase it to make a backup drive."
        elif p.get("uuid") == loc_uuid:
            why = "This is already your backup location."
        if can_use and disk_system:
            roles.append("same drive as your system")
        pct, used_text = 0, ""
        if p.get("fssize") and p.get("fsused") is not None:
            size, used = int(p["fssize"]), int(p["fsused"])
            pct = int(100 * used / size) if size else 0
            used_text = f"{gb(used)} ({pct}%)"
        can_format = not system and not raid and not (whole and disk_system)
        self.dstore.append(parent, [p["path"], p["path"] if not whole else f"{p['path']} (whole drive)",
                                    gb(int(p["size"])), " · ".join(x for x in (fs, p.get("label")) if x),
                                    p.get("label") or "", ", ".join(mps),
                                    pct, used_text, ", ".join(roles), can_use, can_format,
                                    p.get("uuid") or "", fs, why, kind])

    def selected_disk_row(self):
        model, it = self.dtree.get_selection().get_selected()
        return model[it] if it else None

    def use_target(self):
        """The row 'Use for backups' acts on: the selected partition, or a drive's only usable partition.
        Returns (row, note)."""
        model, it = self.dtree.get_selection().get_selected()
        if not it:
            return None, ""
        r = model[it]
        if r[9]:
            return r, ""
        kids = []
        c = model.iter_children(it)
        while c:
            kids.append(model[c])
            c = model.iter_next(c)
        usable = [k for k in kids if k[9]]
        if len(usable) == 1:
            return usable[0], f"<b>Use for backups</b> will use {usable[0][0]}, the usable partition on this drive."
        if len(usable) > 1:
            return None, ("This drive has several partitions that could hold backups; select the one "
                          "you want in the list.")
        if kids and not r[13]:
            return None, "None of this drive's partitions can be used as they are; see each partition for why."
        return None, ""

    def on_disk_selected(self, *_):
        r = self.selected_disk_row()
        if not r:
            self.use_btn.set_sensitive(False)
            self.format_btn.set_sensitive(False)
            self.disk_info.set_markup("<small>Select a partition (the indented rows) to store backups on it, "
                                      "or a whole drive to erase it as a backup drive.</small>")
            return
        target, target_note = self.use_target()
        busy = self.proc is not None
        self.use_btn.set_sensitive(target is not None and not busy)
        self.format_btn.set_sensitive(r[10] and not busy)
        notes = []
        if target_note:
            notes.append(target_note)
        if target is not None:
            fs = target[12]
            if not target_note:
                if target[4] == "PIBACKUP":
                    notes.append(f"<b>Use for backups</b> keeps everything already on {target[0]}; it's labelled "
                                 "PIBACKUP, so backups go in its top folder.")
                else:
                    notes.append(f"<b>Use for backups</b> keeps everything already on {target[0]} and adds a "
                                 "<tt>pi-backups</tt> folder.")
            if fs in SHARED_FS:
                notes.append(f"⚠ {fs} can't keep file permissions: anyone who plugs this drive into "
                             "another computer can read the backups (they include password hashes "
                             "and keys). Erasing it as a backup drive (ext4) avoids that.")
            if "same drive as your system" in target[8]:
                notes.append("⚠ This partition is on the same drive as your system; if that drive "
                             "fails you lose the backups too.")
        if r[10]:
            notes.append(f"<b>Erase</b> wipes {r[0]} and formats it as a dedicated ext4 backup drive.")
        if r[13] and target is None:
            notes.append(r[13])
        if busy:
            notes.append("Wait for the current job to finish.")
        self.disk_info.set_markup("<small>" + "\n".join(notes) + "</small>")

    def on_use_location(self, *_):
        target, _note = self.use_target()
        if not target:
            return
        subdir = "" if target[4] == "PIBACKUP" else "pi-backups"
        where = "its top folder" if not subdir else f"a “{subdir}” folder"
        if not self.confirm(f"Store backups on {target[0]}?",
                            f"Backups will go into {where}. Files already on the partition are not touched."):
            return
        self.run_job(["set-location", "--uuid", target[11], "--subdir", subdir], "Setting backup location…")

    def on_format_location(self, *_):
        r = self.selected_disk_row()
        if not r or not r[10]:
            return
        if not self.ask_erase("Erase and make a backup drive?",
                              f"Everything on {r[0]} ({r[2]}) will be erased and it will be formatted "
                              "as a backup drive called PIBACKUP."):
            return
        self.run_job(["format-location", r[0], "--confirm", "ERASE"], f"Preparing {r[0]}…", cancellable=False)

    # ============================================================ refresh
    def refresh(self):
        self.conf = read_conf()
        loc = self.conf.get("location")
        mounted = location_mounted(self.conf)
        self.backups = read_backups(self.conf) if mounted else []
        if not loc:
            self.status.set_markup("<b>Choose where to keep backups first</b> on the "
                                   "<b>Backup location</b> tab.")
        elif not mounted:
            self.status.set_markup(f"<b>The backup drive isn't connected</b> "
                                   f"({GLib.markup_escape_text(loc['desc'])}).")
        else:
            u = disk_usage(store_dir(self.conf))
            fits = ""
            if self.backups:
                per = backup_size(self.backups[0])
                if per:
                    fits = f" — room for about {int(u.free // per)} more"
            self.status.set_markup(f"Backups on <b>{GLib.markup_escape_text(loc['desc'])}</b>: "
                                   f"<b>{gb(u.free)} free</b>{fits}")
        self.mount_btn.set_visible(bool(loc) and not mounted)
        last = last_scheduled()
        if last:
            icon = "✓" if last.get("ok") else "✗"
            self.last_lbl.set_markup(f"Last scheduled backup: <b>{icon} {last.get('time', '')}</b> — "
                                     f"{GLib.markup_escape_text(last.get('message', ''))}")
        else:
            self.last_lbl.set_text("")

        self.store.clear()
        for c in (self.files_combo, self.sys_combo):
            c.remove_all()
        for m in self.backups:
            notes = []
            if m.get("scheduled"):
                notes.append("scheduled")
            if m.get("md"):
                notes.append("RAID1 system")
            if m.get("model"):
                notes.append(m["model"])
            self.store.append([m["name"], m.get("created", ""), gb(backup_size(m)),
                               m.get("verified", "not yet"), ", ".join(notes)])
            self.files_combo.append(m["name"], m["name"])
            self.sys_combo.append(m["name"], m["name"])
        if self.backups:
            self.files_combo.set_active(0)
            self.sys_combo.set_active(0)
        self.refresh_disks()
        self.refresh_location_tab()
        self.mark_calendar()
        self.on_rebuild_mode()

    def refresh_disks(self):
        loc_uuid = (self.conf.get("location") or {}).get("uuid")
        for c in (self.disk1, self.disk2, self.bootp):
            c.remove_all()
        self.disk2.append("", "(none: start the mirror with one drive)")
        self.bootp.append("", "Leave the boot partition alone")
        for top in block_devices():
            if top.get("type") != "disk" or top["name"].startswith(("zram", "loop", "ram")):
                continue
            nodes = list(walk(top))
            busy = any(not (m.startswith("/media/") or m.startswith("/run/media/"))
                       for n in nodes for m in mounts_of(n))
            if loc_uuid and any(n.get("uuid") == loc_uuid for n in nodes):
                continue
            desc = f"{top['path']} — {gb(int(top['size']))} {top.get('model') or top.get('tran') or ''}".strip()
            if not busy:
                self.disk1.append(top["path"], desc)
                self.disk2.append(top["path"], desc)
            for n in nodes:
                if n.get("type") == "part" and n.get("fstype") == "vfat" and not mounts_of(n):
                    self.bootp.append(n["path"], f"{n['path']} ({gb(int(n['size']))} FAT)")
        self.disk1.set_active(0)
        self.disk2.set_active(0)
        self.bootp.set_active(0)
        has = self.disk1.get_active_id() is not None
        self.rebuild_btn.set_sensitive(has and self.proc is None)
        if not has:
            self.disk1.append("", "(no free drive: every drive is in use or holds the backups)")
            self.disk1.set_active(0)

    def selected_backup(self):
        model, it = self.tree.get_selection().get_selected()
        if it is None:
            self.message("Select a backup in the list first.")
            return None
        return model[it][0]

    # ============================================================ actions
    def on_backup(self, *_):
        opts = self.option_args()
        if opts is not None:
            self.run_job(["backup", "--save-options"] + opts, "Starting backup…")

    def on_verify(self, *_):
        n = self.selected_backup()
        if n:
            self.run_job(["verify", n], f"Checking {n}…")

    def on_delete(self, *_):
        n = self.selected_backup()
        if n and self.confirm(f"Delete backup {n}?", "This can't be undone."):
            self.run_job(["delete", n], f"Deleting {n}…")

    def on_restore_files(self, *_):
        n = self.files_combo.get_active_id()
        paths = [p.strip() for p in self.path_entry.get_text().split(";") if p.strip()]
        if not n or not paths:
            self.message("Choose a backup and enter at least one path.")
            return
        dest = os.path.join(os.path.expanduser("~"), "Restored", n)
        self.after_job = lambda ok: ok and subprocess.Popen(["xdg-open", dest])
        self.run_job(["restore-files", n, "--dest", dest] + paths, "Restoring files…")

    def on_rebuild(self, *_):
        n = self.sys_combo.get_active_id()
        mode = self.rmode_combo.get_active_id()
        d1 = self.disk1.get_active_id()
        d2 = self.disk2.get_active_id() if mode == "raid" else ""
        bp = self.bootp.get_active_id() if mode == "raid" else ""
        if not n or not d1:
            self.message("Choose a backup and a drive.")
            return
        if d2 and d2 == d1:
            self.message("The two drives must be different.")
            return
        drives = [d for d in (d1, d2) if d]
        text = (f"Everything on {' and '.join(drives)} will be erased and replaced with backup {n}."
                + (f" The boot files on {bp} will also be replaced." if bp else ""))
        if not self.ask_erase("Erase and rebuild?", text):
            return
        args = ["restore-system", n, "--mode", mode, "--confirm", "ERASE"]
        for d in drives:
            args += ["--disk", d]
        if bp:
            args += ["--boot-part", bp]
        self.run_job(args, "Rebuilding system…", cancellable=False)

    # ============================================================ job runner
    def run_job(self, args, start_text, cancellable=True):
        if self.proc:
            return
        cmd = ([HELPER] if os.geteuid() == 0 else ["pkexec", HELPER]) + ["--watch-stdin"] + args
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, text=True, bufsize=1)
        except FileNotFoundError as e:
            self.message(f"Couldn't start the helper: {e}", error=True)
            return
        self.got_done = False
        self.bar.set_fraction(0)
        self.bar.set_text(start_text)
        self.append_log(f"$ {' '.join(args)}")
        for w in self.action_widgets:
            w.set_sensitive(False)
        self.cancel_btn.set_sensitive(cancellable)
        threading.Thread(target=self.reader, args=(self.proc,), daemon=True).start()

    def reader(self, p):
        for line in p.stdout:
            GLib.idle_add(self.handle_line, line.rstrip("\n"))
        rc = p.wait()
        GLib.idle_add(self.job_finished, rc)

    def handle_line(self, line):
        kind, _, rest = line.partition(" ")
        if kind == "PROGRESS":
            pct, _, text = rest.partition(" ")
            try:
                self.bar.set_fraction(float(pct) / 100)
            except ValueError:
                pass
            self.bar.set_text(text)
        elif kind == "LOG":
            self.append_log(rest)
        elif kind == "SCAN":
            try:
                r = json.loads(rest)
                self.scan_results.append(r)
                self.append_log(f"{r['unit']}: " + "; ".join(r.get("reasons", [])))
            except ValueError:
                pass
        elif kind == "DONE":
            status, _, msg = rest.partition(" ")
            self.got_done = True
            self.last_ok = status == "ok"
            self.append_log(msg)
            self.bar.set_text("Finished" if self.last_ok else "Failed")
            if self.last_ok:
                self.bar.set_fraction(1)
            if not (self.quiet_done and self.last_ok):
                self.message(msg, error=not self.last_ok)
        else:
            self.append_log(line)
        return False

    def job_finished(self, rc):
        self.proc = None
        if not self.got_done:
            self.last_ok = False
            text = ("Authorisation was cancelled." if rc in (126, 127)
                    else f"The helper stopped unexpectedly (code {rc}).")
            self.bar.set_text(text)
            self.append_log(text)
        for w in self.action_widgets:
            w.set_sensitive(True)
        self.cancel_btn.set_sensitive(False)
        self.quiet_done = False
        cb, self.after_job = self.after_job, None
        if cb:
            cb(self.last_ok)
        self.refresh()
        self.load_schedule_into_ui()
        return False

    def on_cancel(self, *_):
        if self.proc and self.proc.stdin:
            self.bar.set_text("Cancelling…")
            try:
                self.proc.stdin.close()
            except OSError:
                pass

    def on_close(self, *_):
        if self.proc:
            if not self.confirm("A job is still running.", "Closing cancels it. Close anyway?"):
                return True
            self.on_cancel()
        return False

    # ============================================================ dialogs
    def append_log(self, text):
        buf = self.logview.get_buffer()
        buf.insert(buf.get_end_iter(), text + "\n")
        self.logview.scroll_to_iter(buf.get_end_iter(), 0, False, 0, 0)

    def message(self, text, error=False):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=text)
        d.run()
        d.destroy()

    def confirm(self, title, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.YES_NO, text=title)
        d.format_secondary_text(text)
        r = d.run()
        d.destroy()
        return r == Gtk.ResponseType.YES

    def ask_erase(self, title, text):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.OK_CANCEL, text=title)
        dlg.format_secondary_text(text + "\n\nType ERASE to continue.")
        entry = Gtk.Entry()
        dlg.get_message_area().pack_start(entry, False, False, 0)
        ok = dlg.get_widget_for_response(Gtk.ResponseType.OK)
        ok.set_sensitive(False)
        entry.connect("changed", lambda e: ok.set_sensitive(e.get_text() == "ERASE"))
        dlg.show_all()
        resp = dlg.run()
        typed = entry.get_text()
        dlg.destroy()
        return resp == Gtk.ResponseType.OK and typed == "ERASE"


def main():
    prov = Gtk.CssProvider()
    prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = App()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.load_schedule_into_ui()   # re-apply visibility after show_all
    win.on_rebuild_mode()
    conf = read_conf()
    win.mount_btn.set_visible(bool(conf.get("location")) and not location_mounted(conf))
    if not conf.get("location"):
        win.nb.set_current_page(3)
    Gtk.main()


if __name__ == "__main__":
    main()
