def gb(n):
    return f"{n / 1e9:.1f} GB" if n >= 1e9 else f"{n / 1e6:.0f} MB"


# ---------------------------------------------------------------- data helpers (no root needed)
def read_conf():
    try:
        with open(CONF) as f:
            return json.load(f)
    except Exception:
        return {}


def store_dir(conf):
    loc = conf.get("location") or {}
    return os.path.join(MNT, loc["subdir"]) if loc.get("subdir") else MNT


def location_mounted(conf):
    loc = conf.get("location")
    if not loc:
        return False
    if os.environ.get("PIBACKUP_NOMOUNT"):
        return True
    if not os.path.ismount(MNT):
        return False
    u = subprocess.run(["findmnt", "-no", "UUID", MNT], capture_output=True, text=True).stdout.strip()
    return u == loc["uuid"]


def read_backups(conf):
    bdir = os.path.join(store_dir(conf), "backups")
    res = []
    if not os.path.isdir(bdir):
        return res
    for n in sorted(os.listdir(bdir), reverse=True):
        p = os.path.join(bdir, n, "manifest.json")
        if NAME_RE.match(n) and os.path.isfile(p):
            try:
                with open(p) as f:
                    res.append(json.load(f))
            except Exception:
                pass
    return res


def disk_usage(path):
    return shutil.disk_usage(path)


def block_devices():
    try:
        j = subprocess.run(["lsblk", "-J", "-b", "-o",
                            "NAME,PATH,SIZE,TYPE,TRAN,MODEL,FSTYPE,LABEL,UUID,MOUNTPOINTS,RM,FSSIZE,FSUSED"],
                           capture_output=True, text=True).stdout
        return json.loads(j)["blockdevices"]
    except Exception:
        return []


def running_services():
    r = subprocess.run(["systemctl", "list-units", "--type=service", "--state=running",
                        "--no-legend", "--plain"], capture_output=True, text=True).stdout
    return sorted({line.split()[0] for line in r.splitlines() if line.strip()})


def last_scheduled():
    try:
        with open(os.path.join(STATE, "last-scheduled.json")) as f:
            return json.load(f)
    except Exception:
        return None


def walk(n):
    yield n
    for c in n.get("children") or []:
        yield from walk(c)


def mounts_of(n):
    return [p for p in (n.get("mountpoints") or []) if p]


def backup_size(m):
    return sum(f.get("bytes", 0) for f in m.get("files", {}).values())


def schedule_matches(s, day):
    if not s or s.get("mode") in (None, "off"):
        return False
    if s["mode"] == "daily":
        return True
    if s["mode"] == "weekly":
        return DAYS[day.weekday()] in s.get("days", [])
    if s["mode"] == "monthly":
        return day.day == int(s.get("dom", 1))
    return False


def next_runs(s, count=3):
    if not s or s.get("mode") in (None, "off"):
        return []
    hh, mm = (int(x) for x in s.get("time", "02:30").split(":"))
    now = dt.datetime.now()
    day = now.date()
    res = []
    for _ in range(400):
        when = dt.datetime.combine(day, dt.time(hh, mm))
        if when > now and schedule_matches(s, day):
            res.append(when)
            if len(res) >= count:
                break
        day += dt.timedelta(days=1)
    return res


