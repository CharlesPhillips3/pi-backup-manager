def fmt12(hhmm):
    """'02:30' -> '2:30 AM', '14:05' -> '2:05 PM'."""
    hh, mm = (int(x) for x in hhmm.split(":"))
    return f"{hh % 12 or 12}:{mm:02d} {'AM' if hh < 12 else 'PM'}"


def schedule_matches(s, day):
    if not s or s.get("mode") in (None, "off"):
        return False
    if s["mode"] == "daily":
        return True
    if s["mode"] == "weekly":
        return DAYS[day.weekday()] in s.get("days", [])
    if s["mode"] == "monthly":
        return day.day == int(s.get("dom", 1))
    return False


def next_runs(s, count=3):
    if not s or s.get("mode") in (None, "off"):
        return []
    hh, mm = (int(x) for x in s.get("time", "02:30").split(":"))
    now = dt.datetime.now()
    day = now.date()
    res = []
    for _ in range(400):
        when = dt.datetime.combine(day, dt.time(hh, mm))
        if when > now and schedule_matches(s, day):
            res.append(when)
            if len(res) >= count:
                break
        day += dt.timedelta(days=1)
    return res


