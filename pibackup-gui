class MonthGrid(Gtk.Box):
    """A friendly month view: each day is a tile; ✓ = backup made, • = backup scheduled."""

    def __init__(self, marks_func, on_select, on_double=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.marks_func = marks_func
        self.on_select = on_select
        self.on_double = on_double
        today = dt.date.today()
        self.year, self.month, self.selected = today.year, today.month, today
        hdr = Gtk.Box(spacing=4)
        prev, nxt, tb = Gtk.Button(label="‹"), Gtk.Button(label="›"), Gtk.Button(label="Today")
        prev.set_tooltip_text("Previous month")
        nxt.set_tooltip_text("Next month")
        prev.connect("clicked", lambda *_: self.shift(-1))
        nxt.connect("clicked", lambda *_: self.shift(1))
        tb.connect("clicked", lambda *_: self.select(dt.date.today()))
        self.title = Gtk.Label()
        self.title.set_hexpand(True)
        for w in (prev, self.title, nxt, tb):
            hdr.pack_start(w, w is self.title, w is self.title, 0)
        self.pack_start(hdr, False, False, 0)
        grid = Gtk.Grid(row_spacing=3, column_spacing=3, row_homogeneous=True, column_homogeneous=True)
        for i, d in enumerate(DAYS):
            lab = Gtk.Label()
            lab.set_markup(f"<small><b>{d}</b></small>")
            grid.attach(lab, i, 0, 1, 1)
        self.cells = []
        for r in range(6):
            for c in range(7):
                b = Gtk.Button()
                lab = Gtk.Label()
                lab.set_justify(Gtk.Justification.CENTER)
                b.add(lab)
                b.get_style_context().add_class("cal-day")
                b.connect("clicked", lambda btn: self.select(btn.day))
                b.connect("button-press-event", self.on_press)
                grid.attach(b, c, r + 1, 1, 1)
                self.cells.append((b, lab))
        self.pack_start(grid, False, False, 0)
        self.redraw()

    def on_press(self, btn, event):
        if event.type == Gdk.EventType._2BUTTON_PRESS and self.on_double:
            self.select(btn.day)
            GLib.idle_add(lambda: (self.on_double(btn.day), False)[1])
            return True
        return False

    def shift(self, n):
        m = self.month - 1 + n
        self.year, self.month = self.year + m // 12, m % 12 + 1
        self.redraw()

    def select(self, day):
        self.selected = day
        self.year, self.month = day.year, day.month
        self.redraw()
        self.on_select(day)

    def redraw(self):
        self.title.set_markup(f"<b>{calmod.month_name[self.month]} {self.year}</b>")
        first = dt.date(self.year, self.month, 1)
        start = first - dt.timedelta(days=first.weekday())
        today = dt.date.today()
        for i, (b, lab) in enumerate(self.cells):
            d = start + dt.timedelta(days=i)
            b.day = d
            made, sched, extra = self.marks_func(d)
            sym = " ".join(x for x, on in (("✓", made), ("•", sched), ("◆", extra)) if on) or " "
            num = f"<b>{d.day}</b>" if made else str(d.day)
            lab.set_markup(f"{num}\n<small>{sym}</small>")
            ctx = b.get_style_context()
            for cls in ("cal-other", "cal-today", "cal-backup", "cal-sched", "cal-extra", "cal-selected"):
                ctx.remove_class(cls)
            if d.month != self.month:
                ctx.add_class("cal-other")
            if d == today:
                ctx.add_class("cal-today")
            if d == self.selected:
                ctx.add_class("cal-selected")
            elif made:
                ctx.add_class("cal-backup")
            elif extra:
                ctx.add_class("cal-extra")
            elif sched:
                ctx.add_class("cal-sched")
            tip = []
            if made:
                tip.append("backup made")
            if sched:
                tip.append("backup scheduled")
            if extra:
                tip.append("one-time backup")
            if d >= today and self.on_double:
                tip.append("double-click to " + ("change the one-time backup" if extra else "add a one-time backup"))
            b.set_tooltip_text(", ".join(tip).capitalize() if tip else None)


class BackupExplorer(Gtk.Dialog):
    """Browse a backup's contents as a folder tree with checkboxes, then restore the selection."""
    MAXHIT = 2000

    def __init__(self, parent, index_path, name):
        super().__init__(title=f"Browse backup {name}", transient_for=parent, modal=True)
        self.set_default_size(880, 640)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.restore_btn = self.add_button("Restore selected to ~/Restored", Gtk.ResponseType.OK)
        self.restore_btn.get_style_context().add_class("suggested-action")
        self.restore_btn.set_sensitive(False)
        rows = []
        with gzip.open(index_path, "rt", errors="replace") as f:
            for line in f:
                r = line.rstrip("\n").split("\t", 3)
                if len(r) == 4:
                    rows.append(r)
        rows.sort(key=lambda r: r[3])
        self.paths = [r[3] for r in rows]
        self.kinds = [r[0] for r in rows]
        self.sizes = [int(r[1]) if r[1].isdigit() else 0 for r in rows]
        self.dates = [r[2] for r in rows]
        self.cum = [0]
        for z in self.sizes:
            self.cum.append(self.cum[-1] + z)
        self.sel = set()
        self.kids = {}

        area = self.get_content_area()
        area.set_spacing(6)
        area.set_border_width(8)
        top = Gtk.Box(spacing=8)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search file and folder names…")
        self.search.set_hexpand(True)
        self.search.connect("search-changed", self.on_search)
        top.pack_start(self.search, True, True, 0)
        clear = Gtk.Button(label="Clear selection")
        clear.connect("clicked", lambda *_: (self.sel.clear(), self.refresh_marks()))
        top.pack_start(clear, False, False, 0)
        area.pack_start(top, False, False, 0)
        hint = Gtk.Label(xalign=0)
        hint.set_markup("<small>Tick a folder to restore all of it, then untick anything inside you don't want. "
                        f"{len(self.paths):,} items in this backup.</small>")
        area.pack_start(hint, False, False, 0)

        # checked, inconsistent, name, size, date, path, is_dir, icon
        cols = (bool, bool, str, str, str, str, bool, str)
        self.tree_model = Gtk.TreeStore(*cols)
        self.list_model = Gtk.ListStore(*cols)
        self.tv = Gtk.TreeView(model=self.tree_model)
        tr = Gtk.CellRendererToggle()
        tr.connect("toggled", self.on_toggled)
        c = Gtk.TreeViewColumn("", tr, active=0, inconsistent=1)
        self.tv.append_column(c)
        c = Gtk.TreeViewColumn("Name")
        ip = Gtk.CellRendererPixbuf()
        c.pack_start(ip, False)
        c.add_attribute(ip, "icon-name", 7)
        tx = Gtk.CellRendererText()
        tx.set_property("ellipsize", Pango.EllipsizeMode.MIDDLE)
        c.pack_start(tx, True)
        c.add_attribute(tx, "text", 2)
        c.set_expand(True)
        c.set_resizable(True)
        self.tv.append_column(c)
        self.tv.set_expander_column(c)
        for title, idx, w in (("Size", 3, 90), ("Modified", 4, 140)):
            r = Gtk.CellRendererText()
            col = Gtk.TreeViewColumn(title, r, text=idx)
            col.set_min_width(w)
            self.tv.append_column(col)
        self.tv.connect("row-expanded", self.on_expanded)
        self.tv.connect("row-activated", self.on_activated)
        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        sw.add(self.tv)
        area.pack_start(sw, True, True, 0)
        self.status = Gtk.Label(xalign=0)
        area.pack_start(self.status, False, False, 0)
        self.add_rows(None, "")
        self.update_status()
        self.show_all()

    # ---- index helpers
    def span(self, prefix):
        return bisect.bisect_left(self.paths, prefix), bisect.bisect_left(self.paths, prefix + "\U0010ffff")

    def idx(self, p):
        i = bisect.bisect_left(self.paths, p)
        return i if i < len(self.paths) and self.paths[i] == p else None

    def children(self, d):
        if d not in self.kids:
            prefix = d + "/" if d else ""
            lo, hi = self.span(prefix)
            n = len(prefix)
            res = [i for i in range(lo, hi) if "/" not in self.paths[i][n:]]
            res.sort(key=lambda i: (self.kinds[i] != "d", self.paths[i][n:].lower()))
            self.kids[d] = res
        return self.kids[d]

    def subtree_size(self, p):
        i = self.idx(p)
        own = self.sizes[i] if i is not None else 0
        if i is not None and self.kinds[i] != "d":
            return own
        lo, hi = self.span(p + "/")
        return own + self.cum[hi] - self.cum[lo]

    def row_for(self, i, label=None):
        p = self.paths[i]
        isdir = self.kinds[i] == "d"
        icon = {"d": "folder", "l": "emblem-symbolic-link"}.get(self.kinds[i], "text-x-generic")
        return [self.is_selected(p), self.partial(p), label or p.rsplit("/", 1)[-1],
                human(self.subtree_size(p)), self.dates[i], p, isdir, icon]

    def add_rows(self, parent, d):
        for i in self.children(d):
            it = self.tree_model.append(parent, self.row_for(i))
            if self.kinds[i] == "d":
                lo, hi = self.span(self.paths[i] + "/")
                if hi > lo:
                    self.tree_model.append(it, [False, False, "…", "", "", "", False, ""])

    def on_expanded(self, tv, it, path):
        child = self.tree_model.iter_children(it)
        if child is not None and self.tree_model[child][5] == "":
            # add the real rows first: removing the only child would collapse the row again
            self.add_rows(it, self.tree_model[it][5])
            self.tree_model.remove(child)

    def on_activated(self, tv, path, col):
        if tv.get_model() is self.tree_model:
            tv.collapse_row(path) if tv.row_expanded(path) else tv.expand_row(path, False)

    # ---- selection (a selected path means it and everything inside it)
    def ancestors(self, p):
        parts = p.split("/")
        return ["/".join(parts[:k]) for k in range(1, len(parts))]

    def is_selected(self, p):
        return p in self.sel or any(a in self.sel for a in self.ancestors(p))

    def partial(self, p):
        if self.is_selected(p):
            return False
        pre = p + "/"
        return any(x.startswith(pre) for x in self.sel)

    def toggle(self, p):
        if not p:
            return
        if self.is_selected(p):
            if p in self.sel:
                self.sel.discard(p)
            else:
                anc = next(a for a in self.ancestors(p) if a in self.sel)
                self.sel.discard(anc)
                cur = anc
                while cur != p:
                    nxt = p[:p.index("/", len(cur) + 1)] if "/" in p[len(cur) + 1:] else p
                    for i in self.children(cur):
                        if self.paths[i] != nxt:
                            self.sel.add(self.paths[i])
                    cur = nxt
        else:
            pre = p + "/"
            self.sel = {x for x in self.sel if not x.startswith(pre)}
            self.sel.add(p)
        self.refresh_marks()

    def on_toggled(self, renderer, path):
        model = self.tv.get_model()
        self.toggle(model[path][5])

    def refresh_marks(self):
        def upd(model, path, it, _):
            p = model[it][5]
            if p:
                model[it][0] = self.is_selected(p)
                model[it][1] = self.partial(p)
            return False
        self.tree_model.foreach(upd, None)
        self.list_model.foreach(upd, None)
        self.update_status()

    def update_status(self):
        n = len(self.sel)
        size = sum(self.subtree_size(p) for p in self.sel)
        self.status.set_markup(f"<b>{n}</b> item{'s' if n != 1 else ''} selected · {human(size)}" if n
                               else "Nothing selected yet.")
        self.restore_btn.set_sensitive(n > 0)

    # ---- search
    def on_search(self, entry):
        q = entry.get_text().strip().lower()
        if len(q) < 2:
            self.tv.set_model(self.tree_model)
            return
        self.list_model.clear()
        hits = 0
        for i, p in enumerate(self.paths):
            if q in p.rsplit("/", 1)[-1].lower():
                self.list_model.append(self.row_for(i, label="/" + p))
                hits += 1
                if hits >= self.MAXHIT:
                    break
        self.tv.set_model(self.list_model)
        if hits >= self.MAXHIT:
            self.status.set_markup(f"Showing the first {self.MAXHIT} matches; type more to narrow it down.")

    def selection(self):
        return sorted(self.sel)


