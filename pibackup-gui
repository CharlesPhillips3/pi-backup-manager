    def load_schedule_into_ui(self):
        now = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
        self.extras = sorted(x for x in (self.conf.get("extra_runs") or []) if x > now)
        s = self.conf.get("schedule") or {"mode": "off", "time": "02:30", "days": ["Sun"], "dom": 1,
                                          "persistent": True, "verify": False}
        self._loading = True
        self.mode_combo.set_active_id(s.get("mode", "off"))
        hh, mm = s.get("time", "02:30").split(":")
        self.set_ui_time(int(hh))
        self.min_combo.set_active_id(mm if mm in ("00", "15", "30", "45") else "30")
        for d, t in self.day_toggles.items():
            t.set_active(d in (s.get("days") or ["Sun"]))
        self.dom_spin.set_value(int(s.get("dom", 1)))
        self.persist_cb.set_active(bool(s.get("persistent", True)))
        self.verify_cb.set_active(bool(s.get("verify", False)))
        self._loading = False
        self.on_schedule_changed()

    def fill_hours(self):
        self.hour_combo.remove_all()
        if self.use24:
            for h in range(24):
                self.hour_combo.append(f"{h:02d}", f"{h:02d}")
        else:
            for h in range(1, 13):
                self.hour_combo.append(str(h), str(h))
        self.ampm_combo.set_visible(not self.use24)
        self.ampm_combo.set_no_show_all(self.use24)

    def set_ui_time(self, h24):
        if self.use24:
            self.hour_combo.set_active_id(f"{h24:02d}")
        else:
            self.hour_combo.set_active_id(str(h24 % 12 or 12))
            self.ampm_combo.set_active_id("AM" if h24 < 12 else "PM")

    def ui_hour24(self):
        hid = self.hour_combo.get_active_id()
        if hid is None:
            return 2
        if self.use24:
            return int(hid)
        pm = (self.ampm_combo.get_active_id() or "AM") == "PM"
        return (int(hid) % 12) + (12 if pm else 0)

    def ui_time24(self):
        return f"{self.ui_hour24():02d}:{self.min_combo.get_active_id() or '30'}"

    def on_clock_toggled(self, cb):
        h24 = self.ui_hour24()
        self._loading = True
        self.use24 = cb.get_active()
        self.fill_hours()
        self.set_ui_time(h24)
        self._loading = False
        self.prefs["clock24"] = self.use24
        save_prefs(self.prefs)
        self.on_schedule_changed()
        self.refresh_last_label()

    def fmt_time(self, hhmm):
        return hhmm if self.use24 else fmt12(hhmm)

    def ui_schedule(self):
        return {"mode": self.mode_combo.get_active_id() or "off",
                "time": self.ui_time24(),
                "days": [d for d, t in self.day_toggles.items() if t.get_active()],
                "dom": int(self.dom_spin.get_value())}

    def on_schedule_changed(self, *_):
        if getattr(self, "_loading", False):
            return
        s = self.ui_schedule()
        mode = s["mode"]
        self.days_box.set_visible(mode == "weekly")
        self.dom_box.set_visible(mode == "monthly")
        self.time_box.set_visible(mode != "off")
        for w in (self.persist_cb, self.verify_cb):
            w.set_sensitive(mode != "off")
        hh = int(s["time"][:2])
        self.time_hint.set_markup("<small>Night-time is a good choice: the Pi is usually idle.</small>"
                                  if 1 <= hh <= 5 and mode != "off" else "")
        runs = sorted(next_runs(s) + [dt.datetime.strptime(x, "%Y-%m-%d %H:%M") for x in self.extras])[:3]
        if mode == "off" and not runs:
            self.next_lbl.set_markup("Automatic backups are <b>off</b>.")
        elif not runs:
            self.next_lbl.set_markup("<b>Pick at least one day.</b>")
        else:
            self.next_lbl.set_markup("Next backups: <b>" + "</b>, <b>".join(
                f"{r.strftime('%a %d %b')} {self.fmt_time(r.strftime('%H:%M'))}" for r in runs) + "</b>")
        saved = self.conf.get("schedule") or {"mode": "off"}
        changed = any(saved.get(k) != s[k] for k in ("mode", "time", "dom")) or \
            (mode == "weekly" and saved.get("days") != s["days"])
        self.sched_save_btn.set_label("Save schedule" + (" *" if changed else ""))
        self.mark_calendar()

    def mark_calendar(self):
        if hasattr(self, "cal") and hasattr(self, "mode_combo"):
            self.cal.redraw()
            self.show_day(self.cal.selected)

    def backups_on(self, day):
        key = day.strftime("%Y-%m-%d")
        return [b for b in self.backups if b["name"].startswith(key)]

    def scheduled_on(self, day):
        s = self.ui_schedule()
        if day < dt.date.today() or not schedule_matches(s, day):
            return False
        hh, mm = (int(x) for x in s["time"].split(":"))
        return dt.datetime.combine(day, dt.time(hh, mm)) > dt.datetime.now()

    def extras_on(self, day):
        key = day.strftime("%Y-%m-%d")
        return [x for x in self.extras if x.startswith(key)]

    def day_marks(self, day):
        if not hasattr(self, "mode_combo"):
            return False, False, False
        return bool(self.backups_on(day)), self.scheduled_on(day), bool(self.extras_on(day))

    def show_day(self, d):
        lines = [f"<b>{d.strftime('%A %d %B %Y')}</b>"]
        for b in self.backups_on(d):
            chk = b.get("verified", "not checked yet")
            lines.append(f"✓ Backup at {self.fmt_time(b['name'][11:13] + ':' + b['name'][13:])} — {gb(backup_size(b))}"
                         f"{' (scheduled)' if b.get('scheduled') else ''}, checked: {chk}")
        if self.scheduled_on(d):
            lines.append(f"• Backup scheduled at {self.fmt_time(self.ui_schedule()['time'])}")
        for x in self.extras_on(d):
            lines.append(f"◆ One-time backup at {self.fmt_time(x[11:])} (double-click the day to change it)")
        if len(lines) == 1:
            lines.append("Nothing on this day." + ("  Double-click it to add a one-time backup."
                                                   if d >= dt.date.today() else ""))
        self.day_info.set_markup("\n".join(lines))

    def on_save_schedule(self, *_):
        s = self.ui_schedule()
        if s["mode"] == "weekly" and not s["days"]:
            self.message("Pick at least one day of the week.", error=True)
            return
        opts = self.option_args()
        if opts is None:
            return
        args = ["set-schedule", "--mode", s["mode"], "--time", s["time"],
                "--days", ",".join(s["days"]), "--dom", str(s["dom"])] + opts
        if self.persist_cb.get_active():
            args.append("--persistent")
        if self.verify_cb.get_active():
            args.append("--verify")
        args += self.extra_args()
        self.run_job(args, "Saving schedule…")

    def extra_args(self):
        if not self.extras:
            return ["--no-extras"]
        res = []
        for x in self.extras:
            res += ["--extra", x]
        return res

    def on_day_double(self, day):
        if self.proc:
            return
        if day < dt.date.today():
            self.message("That day has already passed. Pick today or a later day for a one-time backup.")
            return
        existing = self.extras_on(day)
        dlg = Gtk.Dialog(title="One-time backup", transient_for=self, modal=True)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        if existing:
            dlg.add_button("Remove", 1)
        okb = dlg.add_button("Change" if existing else "Add backup", Gtk.ResponseType.OK)
        okb.get_style_context().add_class("suggested-action")
        area = dlg.get_content_area()
        area.set_spacing(10)
        area.set_border_width(12)
        head = Gtk.Label(xalign=0)
        head.set_markup(f"<big><b>Back up once on {day.strftime('%A %d %B %Y')}</b></big>")
        area.pack_start(head, False, False, 0)
        row = Gtk.Box(spacing=4)
        row.pack_start(Gtk.Label(label="at"), False, False, 0)
        hc, mc, ac = Gtk.ComboBoxText(), Gtk.ComboBoxText(), Gtk.ComboBoxText()
        if self.use24:
            for h in range(24):
                hc.append(f"{h:02d}", f"{h:02d}")
        else:
            for h in range(1, 13):
                hc.append(str(h), str(h))
            for x in ("AM", "PM"):
                ac.append(x, x)
        for mm in ("00", "15", "30", "45"):
            mc.append(mm, mm)
        if existing:
            h24, mm = int(existing[0][11:13]), existing[0][14:16]
        elif day == dt.date.today():
            nxt = dt.datetime.now() + dt.timedelta(minutes=20)
            h24, mm = nxt.hour, f"{(nxt.minute // 15) * 15:02d}"
        else:
            h24, m2 = (int(x) for x in self.ui_schedule()["time"].split(":"))
            mm = f"{m2:02d}" if f"{m2:02d}" in ("00", "15", "30", "45") else "30"
        if self.use24:
            hc.set_active_id(f"{h24:02d}")
        else:
            hc.set_active_id(str(h24 % 12 or 12))
            ac.set_active_id("AM" if h24 < 12 else "PM")
        mc.set_active_id(mm if mm in ("00", "15", "30", "45") else "00")
        row.pack_start(hc, False, False, 0)
        row.pack_start(Gtk.Label(label=":"), False, False, 0)
        row.pack_start(mc, False, False, 0)
        if not self.use24:
            row.pack_start(ac, False, False, 4)
        area.pack_start(row, False, False, 0)
        note = Gtk.Label(xalign=0)
        note.set_line_wrap(True)
        note.set_max_width_chars(52)
        note.set_markup("<small>This is in addition to your regular schedule and uses the same settings. "
                        "It's saved straight away, and removed by itself once it has run.</small>")
        area.pack_start(note, False, False, 0)
        dlg.show_all()
        resp = dlg.run()
        hid, mid, aid = hc.get_active_id(), mc.get_active_id(), ac.get_active_id()
        dlg.destroy()
        if resp not in (Gtk.ResponseType.OK, 1):
            return
        before = list(self.extras)
        for x in existing:
            self.extras.remove(x)
        if resp == Gtk.ResponseType.OK:
            h = int(hid) if self.use24 else (int(hid) % 12) + (12 if aid == "PM" else 0)
            when = f"{day.strftime('%Y-%m-%d')} {h:02d}:{mid}"
            if when <= dt.datetime.now().strftime("%Y-%m-%d %H:%M"):
                self.extras = before
                self.message("That time has already passed today. Pick a later time.", error=True)
                return
            self.extras = sorted(set(self.extras + [when]))
        self.save_extras()

    def save_extras(self):
        """Save one-time backups now, keeping the regular schedule exactly as it was last saved."""
        saved = self.conf.get("schedule") or {"mode": "off", "time": "02:30", "days": [], "dom": 1,
                                             "persistent": True, "verify": False}
        args = ["set-schedule", "--mode", saved.get("mode", "off"), "--time", saved.get("time", "02:30"),
                "--days", ",".join(saved.get("days") or []), "--dom", str(saved.get("dom", 1))]
        if saved.get("persistent", True):
            args.append("--persistent")
        if saved.get("verify"):
            args.append("--verify")
        args += self.extra_args()
        self.mark_calendar()
        self.on_schedule_changed()
        self.run_job(args, "Saving one-time backup…")


